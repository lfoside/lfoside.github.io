---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Heading from './Heading.astro';

interface Props {
  photo: CollectionEntry<'photos'>;
  /** true только для первого ряда — LCP-элементы грузятся сразу */
  priority?: boolean;
}

const { photo, priority = false } = Astro.props;
const { title, description, image, tags = [], party, term } = photo.data;

/**
 * Импорты src/assets статические и типизированы: если в .md указано имя
 * файла, которого нет в src/assets/photos/, сборка упадёт с внятной ошибкой
 * (защита от опечаток при ручном добавлении контента).
 */
const imageModules = import.meta.glob(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
) as Record<string, { default: ImageMetadata }>;

const meta = imageModules[`../assets/photos/${image}`]?.default;
if (!meta) {
  throw new Error(
    `PhotoCard: файл «${image}» не найден в src/assets/photos (запись «${photo.id}»)`,
  );
}
---

<!-- Карточка-кейс в духе base44-референса: hairline-рамка, чипы поверх фото,
     тех-строка акцентом (читаемым на карточке: яркий #e26439 на #20282a — 4,37:1).
     Hover: рамка+заголовок в акцент, фото scale-105 -->
<article
  class="group flex h-full flex-col border border-paper/15 bg-card transition-colors duration-300 ease-in-out hover:border-accent"
>
  <!-- aspect-[4/3] бронирует место под фото до загрузки: скачков высоты нет -->
  <div class="relative aspect-[4/3] overflow-hidden border-b border-paper/10">
    <Image
      src={meta}
      alt={title}
      width={800}
      height={600}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
    />
    {
      tags.length > 0 && (
        <ul class="absolute top-3 left-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="bg-paper px-2 py-1 font-display text-[11px] tracking-[0.08em] text-ink uppercase shadow-sm">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <Heading as="h3" size="md" class="group-hover:text-accent-text">
      {title}
    </Heading>
    <p class="mt-2 flex-1 text-[13px] leading-relaxed text-muted">{description}</p>

    {(party || term) && (
      <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 border-t border-paper/10 pt-4">
        {party && (
          <div class="flex gap-1.5 font-display text-xs tracking-[0.06em] text-accent-text">
            <dt class="sr-only">Партия</dt>
            <dd>{party}</dd>
          </div>
        )}
        {term && (
          <div class="flex gap-1.5 font-display text-xs tracking-[0.06em] text-accent-text">
            <dt class="sr-only">Срок</dt>
            <dd>{term}</dd>
          </div>
        )}
      </dl>
    )}
  </div>
</article>
