---
/**
 * Секция «4 шага до детали».
 *
 * Полоса шагов — ячейки в hairline-полосе на gap-px (тот же приём, что в
 * полосе фактов hero): контейнер красится линией, ячейки — фоном секции,
 * поэтому низы рядов равны по построению, а не по min-height, и двойных
 * границ нет ни на одном брейкпоинте.
 *
 * Порядок (а не «четыре колонки текста») задают две вещи: размерная линия
 * с узлом сверху каждой ячейки — узлы складываются в одну «шкалу» поперёк
 * полосы, как выноска на чертеже; и явный «ШАГ NN» перед названием. Стрелки
 * не нужны: они в этом сайте не рисуют нигде, а hairline-язык уже есть.
 *
 * Фон — общий paper (без paper-2): разница в 9 пунктов ритмом не читалась,
 * а контраст акцента в этой секции обваливался до 2,60:1.
 */
import Heading from './Heading.astro';
import SectionHeading from './SectionHeading.astro';

const steps = [
  { n: '01', t: 'Заявка', d: 'Пришлите чертёж или фото образца. Почта, мессенджер — как удобно. DXF, STEP, DWG, PDF.' },
  { n: '02', t: 'Расчёт', d: 'Получите расчёт в течение 1–3 дней: сроки, стоимость и возможные варианты оптимизации.' },
  { n: '03', t: 'Предоплата', d: 'Подтвердите заказ и внесите предоплату — 50%. Остаток по факту готовности.' },
  { n: '04', t: 'Получение', d: 'Заберите готовую партию. Доставка по Москве и области или самовывоз — адрес цеха в контактах.' },
];
---

<section id="process" class="tone-light bg-paper text-ink">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <!-- Заголовок и лид одной строкой: без лида правая половина шапки секции
         была пустой бумагой, и H2 «висел» один на всю ширину. -->
    <div class="grid items-end gap-8 border-b border-ink/15 pb-12 lg:grid-cols-[0.55fr_0.45fr] lg:gap-16" data-reveal>
      <SectionHeading num="04" kicker="Этапы" title1="Четыре шага" title2="до детали" tight />
      <p class="max-w-md text-base leading-relaxed text-ink/70">
        Порядок работы одинаков для штучной детали и для серии: срок считаем от дня
        подтверждения заказа, предоплата — 50%, остаток по факту готовности.
      </p>
    </div>

    <ol class="mt-12 grid grid-cols-1 gap-px border-y border-ink/15 bg-ink/15 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {
        steps.map((s, i) => (
          <li class="flex flex-col bg-paper p-6 transition-colors duration-300 hover:bg-paper/50">
            <!-- размерная линия с узлом: узлы четырёх ячеек читаются одной шкалой -->
            <span class="flex items-center gap-1.5" aria-hidden="true">
              <span class:list={['h-px flex-1 bg-ink/30', i === 0 && 'invisible']}></span>
              <span class="size-2 shrink-0 bg-accent-text"></span>
              <span class:list={['h-px flex-1 bg-ink/30', i === steps.length - 1 && 'invisible']}></span>
            </span>
            <p class="mt-5 font-display text-sm font-semibold tracking-[0.14em] text-accent-text uppercase">
              Шаг&nbsp;{s.n}
            </p>
            <Heading as="h3" size="lg" class="mt-1.5">
              {s.t}
            </Heading>
            <p class="mt-3 max-w-[240px] text-sm leading-relaxed text-ink/70">{s.d}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
