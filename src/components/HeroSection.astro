---
/**
 * Hero (01 / НАЧАЛО) — тёмная секция, единственный на странице H1.
 *
 * Механика перенята у metapro (индексный маркер, гигантский дисплейный
 * заголовок с акцентной последней строкой, асимметричная рамка визуала со
 * смещённым внутренним контуром, штамп, полоса фактов), композиция и
 * визуал — свои.
 *
 * Визуал — чертёж точёного вала, нарисованный SVG; фото цеха (слой ниже,
 * `shop-1.jpg`) работает только атмосферой под 16% затемнения. Причины
 * выбрать чертёж главным: (1) наш продукт и есть чертёж — «пришлите
 * DXF/STEP» буквально визуализирован; (2) ~3 КБ против тяжёлого JPEG в
 * LCP-позиции; (3) не дублирует карточки галереи.
 *
 * Перенос в H1 — автоматический (hyphens: auto + lang="ru" на <html>):
 * визуально «МЕТАЛЛО- / ОБРАБОТКА», в DOM по-прежнему чистое
 * «металлообработка» — без дефиса, который портил бы точное вхождение
 * ключевого слова.
 *
 * Анимация появления — чистый CSS при загрузке (НЕ data-reveal: первый экран
 * не должен зависеть от JS). Под prefers-reduced-motion отключена.
 */
import { Picture } from 'astro:assets';
import Heading from './Heading.astro';
import shopPhoto from '../assets/photos/shop-1.jpg';

// Полоса фактов. Всё, кроме срока, подтверждается текстом других секций
// (точность и объёмы — FAQ, расчёт 1–3 дня — «Четыре шага», география — футер);
// «24 года / с 2002» — со слов заказчика, подтверждён при сборке hero.
const facts = [
  { v: '24', u: 'года', l: 'работаем с 2002 года' },
  { v: '±0,01', u: 'мм', l: 'точность на ЧПУ', hi: true },
  { v: 'от 1', u: 'шт.', l: 'штучно и серии' },
  { v: '1–3', u: 'дня', l: 'расчёт по чертежу' },
  { v: 'Москва', u: 'и МО', l: 'свой цех и доставка' },
];
---

<section id="hero" class="relative isolate overflow-hidden bg-ink text-paper">
  <!--
    Атмосферный слой: токарный станок в работе (Unsplash, свободная лицензия,
    автор — в LICENSE-NOTES.md). Лессировка, а не содержание: 16%
    непрозрачности, обесцвечивание и градиент, оставляющий левую половину
    почти чистым ink. Лежит НИЖЕ разлиновки, чтобы сетка не тонула в фото.

    Формат и вес: AVIF с WebP-фолбэком, quality 40, максимальная ширина 960 —
    раньше с этим фото шло 78,7 КБ по сети (1440w при quality 70) и три
    варианта srcset на 229 КБ на диске. Замер LCP-наблюдателем: у картинки на
    весь экран fetchpriority="low" от кандидата на LCP не спасает — она всё
    равно оставалась LCP-элементом (область 1440×854). Значит главный рычаг
    здесь — размер файла, а не подсказка приоритета.
  -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <Picture
      src={shopPhoto}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      quality={40}
      widths={[640, 960]}
      sizes="100vw"
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="low"
      class="h-full w-full object-cover opacity-[0.16] saturate-[0.55]"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/60"></div>
  </div>

  <!-- Фоновая разлиновка «миллиметровки», гаснет к правому краю -->
  <div class="hero-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto flex max-w-6xl flex-col px-4 pt-12 pb-8 sm:px-6 lg:min-h-[calc(100svh-7rem)] lg:justify-center lg:pt-12">
    <!-- Маркер и H1 — на всю ширину: 17-буквенное слово не уместить в колонку,
         а масштаб заголовка задаёт тон всему первому экрану. -->
    <p class="rise d1 flex items-center gap-4">
      <span class="font-display text-[10px] font-semibold tracking-[0.2em] text-accent-text uppercase">
        01&nbsp;/&nbsp;НАЧАЛО
      </span>
      <span class="h-px flex-1 bg-current opacity-15" aria-hidden="true"></span>
    </p>

    <Heading as="h1" size="display" class="rise d2 mt-5 uppercase hyphens-auto">
      Металлообработка<br />
      <em class="text-accent-text not-italic">на заказ.</em>
    </Heading>

    <div class="mt-10 grid items-center gap-x-14 gap-y-12 lg:mt-10 lg:grid-cols-[minmax(0,0.5fr)_minmax(0,0.5fr)]">
      <!-- ЛЕВАЯ КОЛОНКА: чем именно полезны + целевое действие -->
      <div>
        <p class="rise d3 flex flex-wrap items-center gap-x-2.5 gap-y-1 font-display text-[10px] tracking-[0.2em] text-muted uppercase">
          <span class="size-2 shrink-0 bg-accent" aria-hidden="true"></span>
          собственный цех · москва и область
        </p>

        <p class="rise d3 mt-5 max-w-[42ch] text-base leading-relaxed text-paper/70 sm:text-lg">
          Токарные, фрезерные, сварочные и слесарные работы на ЧПУ: от штучной детали
          и прототипа до серийной партии. Изготавливаем строго по вашему чертежу,
          эскизу или образцу.
        </p>

        <div class="rise d4 mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="#request"
            class="group inline-flex items-center justify-center gap-2 bg-accent px-6 py-3.5 text-sm font-semibold tracking-[0.06em] text-ink uppercase transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:bg-accent-2"
          >
            Рассчитать стоимость
            <svg viewBox="0 0 24 24" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </a>
          <a
            href="#gallery"
            class="inline-flex items-center justify-center border border-paper/25 px-6 py-3.5 text-sm font-semibold tracking-[0.06em] text-paper uppercase transition-colors duration-300 hover:border-accent-text hover:text-accent-text"
          >
            Примеры работ
          </a>
        </div>
      </div>

      <!-- ПРАВАЯ КОЛОНКА: чертёж в «двойной» рамке + штамп допуска -->
      <div class="rise d3 relative">
        <!-- внешний контур смещён вниз-влево: лист на кульмане -->
        <div class="border border-paper/15 pb-5 pl-5">
          <div class="rounded-br-[2.5rem] border border-accent/35 bg-ink-2/50 p-3 sm:p-5">
            <svg
              viewBox="14 78 606 336"
              class="h-auto w-full font-display text-paper"
              role="img"
              aria-labelledby="hero-drawing-title"
            >
              <title id="hero-drawing-title">
                Чертёж ступенчатого вала: диаметр 128 мм, длина 3000 мм, допуск ±0,01 мм
              </title>

              <!-- засечка угла листа -->
              <path d="M28 96h12M34 90v12" class="g-dims" stroke="currentColor" stroke-width="1" opacity="0.35" />

              <!-- ось детали -->
              <path d="M36 200h568" stroke="currentColor" stroke-width="1" opacity="0.3" stroke-dasharray="22 5 4 5" />

              <!-- профиль вала: заполнение + обводка (обводка «прорисовывается» штрихом) -->
              <path
                d="M60 170h90v-22h120v10h160v-22h130v128H430v-22H270v10H150v-22H60Z"
                fill="currentColor"
                opacity="0.05"
              />
              <path
                class="draw"
                pathLength="1"
                d="M60 170h90v-22h120v10h160v-22h130v128H430v-22H270v10H150v-22H60Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                opacity="0.75"
              />

              <!-- резьба на левом конце и накатка на правом -->
              <g class="g-dims" stroke="currentColor" stroke-width="0.9" opacity="0.28">
                <path d="M68 172v56M79 172v56M90 172v56M101 172v56M112 172v56M123 172v56M134 172v56M145 172v56" />
                <path d="M438 138l32 124M462 138l32 124M486 138l32 124M510 138l32 124M534 138l26 101" opacity="0.5" />
              </g>

              <!-- размерные линии: на узких экранах прячем — там важна деталь, а не выноски -->
              <g class="g-dims max-sm:hidden" stroke="currentColor" stroke-width="1" opacity="0.45">
                <path d="M60 240v68M560 272v36M60 300h500" />
                <path d="M54 306l12-12M554 294l12 12" />
                <path d="M430 130v-26M560 130v-26M430 112h130" />
                <path d="M424 118l12-12M554 106l12 12" />
                <path d="M566 136h46M566 264h46M604 136v128" />
                <path d="M598 142l12-12M598 258l12 12" />
                <path d="M344 262l6-16h6" />
              </g>

              <g class="g-dims max-sm:hidden" fill="currentColor" opacity="0.6" font-size="13">
                <text x="310" y="292" text-anchor="middle">L 3 000</text>
                <text x="495" y="104" text-anchor="middle">180</text>
                <text x="592" y="200" text-anchor="middle" dominant-baseline="middle" transform="rotate(-90 592 200)">Ø 128</text>
                <text x="360" y="266" font-size="11">Ra 1,6</text>
                <text x="176" y="112" font-size="12">М60×2</text>
              </g>

              <!-- выноска резьбы: акцент в рисунке не нужен, он уже в штампе -->
              <g class="g-dims">
                <path d="M105 170l23-56h42" fill="none" stroke="currentColor" stroke-width="1" opacity="0.45" />
                <circle cx="105" cy="170" r="2.2" fill="currentColor" opacity="0.6" />
              </g>

              <!-- основная надпись -->
              <g class="g-dims max-sm:hidden">
                <rect x="372" y="346" width="248" height="58" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3" />
                <path d="M500 346v58M372 368h248" stroke="currentColor" stroke-width="1" opacity="0.22" />
                <g fill="currentColor" font-size="11">
                  <text x="384" y="361" opacity="0.75" letter-spacing="1.4">ТОКАРКА ПРО</text>
                  <text x="512" y="361" opacity="0.45">лист 01</text>
                  <text x="384" y="389" opacity="0.45">чертёж заказчика</text>
                  <text x="512" y="389" opacity="0.45">инв. №001</text>
                </g>
              </g>
            </svg>
          </div>
        </div>

        <!-- штамп допуска: квадратный, в язык системы, а не «печать-кругляш» -->
        <div class="absolute -top-4 right-6 border border-accent/60 bg-ink px-3 py-2 text-center">
          <p class="font-display text-lg leading-none font-bold tracking-[-0.03em] text-accent-text">±0,01</p>
          <p class="mt-1 font-display text-[11px] tracking-[0.18em] text-accent-text uppercase">допуск, мм</p>
        </div>

        <p class="mt-5 font-display text-[10px] leading-relaxed tracking-[0.2em] text-muted uppercase">
          сталь · алюминий · латунь · титан · капролон
        </p>
      </div>
    </div>

    <!--
      Полоса фактов. Приём «разлиновки через gap-px» — с base44-референса:
      контейнер красится линией, ячейки — фоном, поэтому в щелях остаются
      идеальные одинарные hairline: без двойных границ, без «висячих»
      разделителей и без border-ловушек на неполном последнем ряду.
      Акцент — ровно на одном значении (точность): цвет как калиброванная
      редкость, а не декор.
    -->
    <ul class="mt-10 grid grid-cols-2 gap-px border-y border-paper/15 bg-paper/15 sm:mt-12 lg:grid-cols-5">
      {
        facts.map((f, i) => {
          const last = i === facts.length - 1;
          return (
            <li
              class:list={[
                'bg-ink p-4 transition-colors duration-300 hover:bg-ink-2 sm:p-5',
                last && 'col-span-2 lg:col-span-1',
              ]}
            >
              <p
                class:list={[
                  'font-display text-xl leading-none font-bold tracking-[-0.045em] sm:text-[26px]',
                  f.hi ? 'text-accent-text' : 'text-paper',
                ]}
              >
                {f.v}&nbsp;<span class="text-xs font-semibold text-muted sm:text-sm">{f.u}</span>
              </p>
              <p class="mt-2.5 font-display text-[11px] tracking-[0.18em] text-muted uppercase sm:mt-3">
                {f.l}
              </p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /*
   * Разлиновка кульмана. Маска нужна, чтобы сетка не спорила с текстом
   * и таяла к правому краю. В отличие от референса сетка не глобальная
   * (fixed) — у нас светлые секции, поэтому она живёт только в hero.
   */
  .hero-grid {
    background-image:
      linear-gradient(to right, rgb(232 233 226 / 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(232 233 226 / 0.06) 1px, transparent 1px);
    background-size: 76px 76px;
    -webkit-mask-image: linear-gradient(90deg, #000 0%, rgb(0 0 0 / 0.35) 55%, transparent 88%);
    mask-image: linear-gradient(90deg, #000 0%, rgb(0 0 0 / 0.35) 55%, transparent 88%);
  }

  /* Появление текста: ступенчатый rise, пока чертёж «рисует» штрих */
  .rise {
    animation: hero-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .d1 {
    animation-delay: 0.05s;
  }

  .d2 {
    animation-delay: 0.13s;
  }

  .d3 {
    animation-delay: 0.21s;
  }

  .d4 {
    animation-delay: 0.29s;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(0.9rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Обводка чертежа проводится одним штрихом (pathLength = 1) */
  .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hero-draw 1.3s ease-out 0.2s forwards;
  }

  @keyframes hero-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Выноски и основная надпись догружаются после штриха */
  .g-dims {
    animation: hero-fade 0.6s ease-out 1.05s both;
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise,
    .g-dims {
      animation: none;
    }

    .draw {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
