---
/**
 * Секция «Услуги»: строки-аккордеоны «номер | название | +» с hairline.
 * Механика ряда — metapro (38%/62% + список, не карточки), раскрытие —
 * нативные <details>/<summary> как в FAQ: 0 JS, доступность с коробки,
 * описание остаётся в DOM для поисковика.
 *
 * Тексты — переработанные описания услуг (исходник: чужой коммерческий
 * текст «Альфа-Мастер», оставлены только факты: технологии, материалы,
 * габариты). Габариты — единые с FAQ: токарка Ø до 500 / L до 3000 мм,
 * фрезеровка до 1000×500 мм.
 */
import Heading from './Heading.astro';
import SectionHeading from './SectionHeading.astro';

const services = [
  {
    n: '01',
    t: 'Токарные работы',
    d: 'Токарная обработка деталей из металлов — сталь, алюминий, медь, латунь — и капролона на станках с ЧПУ и с ручным управлением: сверление, растачивание, нарезание резьбы, продольное и поперечное точение, снятие фасок, контурная резка. Работаем по чертежам, эскизам и образцам, от одной детали до серии.',
    spec: 'Диаметр обработки — до 500 мм · длина — до 3000 мм',
  },
  {
    n: '02',
    t: 'Фрезерные работы',
    d: 'Вертикально-фрезерные станки с ЧПУ: фасонная обработка профилей, концевая — пазы, окна, колодцы и канавки заданных параметров, торцевая — поверхности больших площадей. Металл и пластмассы, работа по чертежам и файлам AutoCAD. Программное управление процессом даёт точность профиля любой сложности.',
    spec: 'Габариты заготовки — до 1000 × 500 мм',
  },
  {
    n: '03',
    t: 'Сварочные работы',
    d: 'Полуавтоматическая и аргонодуговая сварка: алюминий, нержавеющая, легированная и высокоуглеродистая сталь. Защитная газовая среда обеспечивает плотный стойкий к коррозии шов; аргонодуговая технология — для точных швов с повышенными требованиями. Одиночные детали и серийные партии.',
    spec: null,
  },
  {
    n: '04',
    t: 'Слесарные работы',
    d: 'Слесарно-сборочные работы по единой технологической цепочке: разметка, рубка, гибка и правка, опиливание, резка, зенкерование, сверление, развёртывание отверстий, нарезка резьбы, клёпка, притирка и доводка. Листогибочные прессы и гильотинные ножницы — как самостоятельная услуга или дополнительный этап другой мехобработки.',
    spec: null,
  },
];
---

<section id="services" class="bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="grid gap-10 lg:grid-cols-[38fr_62fr] lg:gap-16" data-reveal>
      <div>
        <SectionHeading num="03" kicker="Услуги" title1="Что умеем" title2="делать" />
        <p class="-mt-8 max-w-[240px] text-sm leading-relaxed text-muted">
          Выбираем технологию под задачу, а не задачу под станок.
        </p>
        <a
          href="#request"
          class="group mt-8 inline-flex items-center gap-2 bg-accent px-5 py-3 text-sm font-semibold text-ink transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:bg-accent-2"
        >
          Прислать чертёж
          <svg viewBox="0 0 24 24" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
      </div>

      <ul class="mt-4 border-t border-paper/20 lg:mt-12">
        {
          services.map((s) => (
            <li>
              {/* id — цель якорных ссылок из «О компании»; отступ под sticky-шапку
                  задаёт scroll-padding-top в global.css (один на все якоря);
                  name — «эксклюзивный» аккордеон: открыта только одна строка (нативно, без JS) */}
              <details id={`srv-${s.n}`} name="services" class="group">
                <summary
                  class="grid min-h-[84px] cursor-pointer list-none grid-cols-[44px_1fr_24px] items-center gap-2 border-b border-paper/20 transition-all duration-300 ease-in-out [::-webkit-details-marker]:hidden hover:pl-2.5 hover:text-accent-text group-open:text-accent-text"
                >
                  <span class="font-display text-xs font-semibold text-accent-text">{s.n}</span>
                  <Heading as="h3" size="lg" class="!text-2xl sm:!text-[1.6rem]">
                    {s.t}
                  </Heading>
                  <!-- тот же квадрат «+/−», что в FAQ: механика едина по странице -->
                  <span class="grid size-8 shrink-0 place-items-center self-center border border-paper/20 text-paper transition-colors duration-300 group-open:border-accent group-open:bg-accent group-open:text-ink">
                    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                      <path d="M5 12h14" />
                      <path d="M12 5v14" class="group-open:hidden" />
                    </svg>
                  </span>
                </summary>

                <div class="max-w-2xl pb-7 pl-[52px] pr-2">
                  <p class="pt-2 text-sm leading-relaxed text-muted">{s.d}</p>
                  {
                    s.spec && (
                      <p class="mt-3 font-display text-xs font-semibold tracking-[0.06em] text-accent-text uppercase">
                        {s.spec}
                      </p>
                    )
                  }
                  <a
                    href="#request"
                    class="group/cta mt-4 -my-2.5 inline-flex items-center gap-1.5 py-2.5 text-sm font-semibold transition-colors duration-300 hover:text-accent-2"
                  >
                    Оставить заявку
                    <svg viewBox="0 0 24 24" class="size-4 transition-transform duration-300 group-hover/cta:translate-x-0.5 group-hover/cta:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                </div>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script data-astro-rerun>
  // Раскрыть <details> строки услуг при переходе на якорь #srv-NN:
  // клик по пункту в «О компании» или прямая ссылка вида /#srv-02.
  function revealInstantly(el) {
    // Строка лежит внутри [data-reveal], который до появления в вьюпорте
    // сдвинут на translateY(1rem). Цель плавного скролла браузер считает один
    // раз по «сдвинутому» положению, а к концу анимации блок доезжает вверх —
    // строка останавливалась на 16px выше шапки. Показываем блок сразу и без
    // перехода: пользователь в этот момент ещё выше по странице, подмены
    // анимации не заметит, а расчёт скролла станет точным.
    const host = el.closest('[data-reveal]');
    if (!host || host.classList.contains('is-visible')) return;
    host.style.transition = 'none';
    host.classList.add('is-visible');
    requestAnimationFrame(() => {
      host.style.transition = '';
    });
  }
  function openService(id, rescroll = true) {
    const el = document.getElementById(id);
    if (!(el instanceof HTMLDetailsElement) || el.open) return;
    revealInstantly(el);
    el.open = true;
    // Нужен только при прямой загрузке /#srv-NN или hashchange: нативный
    // переход к фрагменту случается до раскрытия (и до пригрузки веб-шрифта),
    // браузер считает позицию от закрытой строки и заносит её на ~130px под
    // шапку. При клике раскрытие происходит синхронно, до default action, и
    // браузер сам доходит до нужного места — второй scrollIntoView там только
    // конфликтует с уже идущим плавным скроллом.
    if (rescroll) requestAnimationFrame(() => el.scrollIntoView({ block: 'start' }));
  }
  function openServiceFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (id.startsWith('srv-')) openService(id);
  }
  openServiceFromHash();

  // Слушатели вешаем один раз: window переживает переходы ClientRouter,
  // а скрипт с data-astro-rerun выполняется заново на каждой навигации.
  if (!window.__srvAnchors) {
    window.__srvAnchors = true;
    addEventListener('hashchange', openServiceFromHash);
    // ClientRouter может подменить хеш-навигацию на pushState без hashchange —
    // раскрываем панель сразу по клику, до скролла
    addEventListener('click', (e) => {
      const link = e.target instanceof Element ? e.target.closest('a[href^="#srv-"]') : null;
      if (link) openService(decodeURIComponent(link.getAttribute('href').slice(1)), false);
    });
  }
</script>
