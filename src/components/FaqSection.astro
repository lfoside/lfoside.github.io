---
/**
 * Секция «Вопрос-ответ»: sticky-колонка интро+CTA слева, hairline-строки справа.
 * Механика — base44-референс, но реализована на нативных <details>/<summary>:
 *  - 0 байт JavaScript (в референсе — самописный аккордеон на max-height:400px);
 *  - доступность с коробки (развернут/свернут, управление с клавиатуры);
 *  - закрытые ответы остаются в DOM — поисковики их видят;
 *  - плюс Schema.org FAQPage микроразметка для расширенных сниппетов.
 */
import Heading from './Heading.astro';
import SectionHeading from './SectionHeading.astro';

const faq = [
  {
    q: 'Можно ли заказать у вас изготовление изделия в количестве одного экземпляра по моему чертежу?',
    a: 'Да, мы спокойно берём единичные детали — это даже наша сильная сторона: быстро считаем, быстро запускаем. Если есть чертёж или 3D-модель — присылайте, сделаем расчёт и назовём сроки. Даже если деталь нестандартная, разберёмся.',
  },
  {
    q: 'Как рассчитывается стоимость металлообработки?',
    a: 'Стоимость считаем по вашему чертежу: смотрим тип операций (токарка, фрезеровка и т.д.), материал, сложность геометрии и объём партии. У нас нет «средней цены за килограмм» — считаем именно под задачу, чтобы вы понимали, за что платите. Пришлите файл — подготовим КП за 1–3 рабочих дня.',
  },
  {
    q: 'Из каких материалов вы можете изготавливать изделия?',
    a: 'Работаем с металлами: алюминий, сталь, нержавейка, латунь, бронза, титан — и с инженерными пластиками: капролон, фторопласт, POM, PEEK. Если не уверены, какой материал лучше для вашей детали, подскажем: учтём нагрузку, среду эксплуатации и требования к точности.',
  },
  {
    q: 'Какая точность обработки изделий у вас возможна?',
    a: 'На ЧПУ-станках стабильно держим точность ±0,01 мм — этого достаточно для большинства машиностроительных и приборных задач.',
  },
  {
    q: 'Какой максимальный размер заготовки вы можете обработать?',
    a: 'Возможности зависят от типа операции. Для фрезеровки и резки — до 1000×500 мм. Для токарной обработки — длина до 3000 мм, диаметр до 500 мм.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<!-- Светлая (paper): поддерживает строгое чередование тонов галерея(тёмн) → FAQ(светл) → футер(тёмн) -->
<section id="faq" class="tone-light bg-paper text-ink">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <!-- Липкая колонка интро + CTA -->
    <div class="lg:sticky lg:top-28 lg:self-start">
      <SectionHeading num="06" kicker="FAQ" title1="Вопрос" title2="ответ" />
      <p class="-mt-10 mb-8 text-base leading-relaxed text-ink/70">
        Собрали частые вопросы по металлообработке, материалам и точности. Не нашли ответ — напишите нам.
      </p>
      <a
        href="mailto:info@tokarkapro.ru"
        class="group inline-flex items-center gap-2 bg-accent px-5 py-3 text-sm font-semibold text-ink transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:bg-accent-2"
      >
        Задать вопрос
        <svg viewBox="0 0 24 24" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7M7 7h10v10" />
        </svg>
      </a>
    </div>

    <!-- Hairline-строки аккордеона -->
    <div class="border-t border-ink/10" data-reveal>
      {
        faq.map((item, i) => (
          <details class="group border-b border-ink/10">
            <summary
              class="flex cursor-pointer list-none items-start justify-between gap-5 py-6 transition-colors duration-300 [::-webkit-details-marker]:hidden hover:text-accent-text group-open:text-accent-text"
            >
              <Heading as="h3" size="md" class="font-display font-semibold">
                {item.q}
              </Heading>
              <!-- Квадратный бокс 32px: плюс превращается в минус средней чертой (CSS-only) -->
              <span class="grid size-8 shrink-0 place-items-center border border-ink/20 text-ink transition-colors duration-300 group-open:border-accent-text group-open:bg-accent-text group-open:text-paper">
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 12h14" />
                  <path d="M12 5v14" class="group-open:hidden" />
                </svg>
              </span>
            </summary>
            <p id={`faq-answer-${i}`} class="pr-0 pb-6 text-[15px] leading-relaxed text-ink/70 sm:pr-12">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>

  <!-- Микроразметка Schema.org для расширенных сниппетов в поиске -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
